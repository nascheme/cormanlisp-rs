;;; Ray tracer benchmark, ported from jeaye's Clojure ray tracer gist
;;; (maps as vec3s) to Common Lisp style: structs, loops, multiple values.
;;; Same algorithm and allocation pattern (immutable vec3s).
;;;
;;; Usage: cormanlisp --image cormanlisp.img -e '(load "scripts/bench-ray.lisp") (bench)'

(defvar *w* 100)

(defun rand () (random 1d0))
(defun rand-real (min max) (+ min (* (- max min) (rand))))
(defun clamp (n min max) (cond ((< n min) min) ((< max n) max) (t n)))
(defun degrees->radians (deg) (/ (* deg pi) 180d0))

(defstruct (vec3 (:constructor vec3 (r g b)))
  (r 0d0 :type double-float)
  (g 0d0 :type double-float)
  (b 0d0 :type double-float))

(defun v (r g b) (vec3 (float r 1d0) (float g 1d0) (float b 1d0)))
(defun vec3-scale (l n)
  (vec3 (* (vec3-r l) n) (* (vec3-g l) n) (* (vec3-b l) n)))
(defun vec3-add (l r)
  (vec3 (+ (vec3-r l) (vec3-r r)) (+ (vec3-g l) (vec3-g r)) (+ (vec3-b l) (vec3-b r))))
(defun vec3-sub (l r)
  (vec3 (- (vec3-r l) (vec3-r r)) (- (vec3-g l) (vec3-g r)) (- (vec3-b l) (vec3-b r))))
(defun vec3-mul (l r)
  (vec3 (* (vec3-r l) (vec3-r r)) (* (vec3-g l) (vec3-g r)) (* (vec3-b l) (vec3-b r))))
(defun vec3-div (l n)
  (vec3 (/ (vec3-r l) n) (/ (vec3-g l) n) (/ (vec3-b l) n)))
(defun vec3-dot (l r)
  (+ (* (vec3-r l) (vec3-r r)) (* (vec3-g l) (vec3-g r)) (* (vec3-b l) (vec3-b r))))
(defun vec3-length-squared (v) (vec3-dot v v))
(defun vec3-length (v) (sqrt (vec3-length-squared v)))
(defun vec3-cross (l r)
  (vec3 (- (* (vec3-g l) (vec3-b r)) (* (vec3-b l) (vec3-g r)))
        (- (* (vec3-b l) (vec3-r r)) (* (vec3-r l) (vec3-b r)))
        (- (* (vec3-r l) (vec3-g r)) (* (vec3-g l) (vec3-r r)))))
(defun vec3-normalize (v) (vec3-div v (vec3-length v)))
(defun vec3-neg (v) (vec3 (- (vec3-r v)) (- (vec3-g v)) (- (vec3-b v))))
(defun vec3-rand-in-sphere ()
  (loop (let ((v (vec3 (rand-real -1d0 1d0) (rand-real -1d0 1d0) (rand-real -1d0 1d0))))
          (when (< 1d0 (vec3-length-squared v)) (return v)))))
(defun vec3-rand-unit-in-sphere () (vec3-normalize (vec3-rand-in-sphere)))
(defun vec3-near-zero-p (v)
  (let ((e 0.0000008d0))
    (and (< (abs (vec3-r v)) e) (< (abs (vec3-g v)) e) (< (abs (vec3-b v)) e))))
(defun vec3-reflect (v n)
  (vec3-sub v (vec3-scale n (* 2 (vec3-dot v n)))))
(defun vec3-refract (uv n etai-over-etat)
  (let* ((cos-theta (min (vec3-dot (vec3-neg uv) n) 1d0))
         (r-out-perp (vec3-scale (vec3-add uv (vec3-scale n cos-theta)) etai-over-etat))
         (r-out-parallel (vec3-scale n (- (sqrt (abs (- 1d0 (vec3-length-squared r-out-perp))))))))
    (vec3-add r-out-perp r-out-parallel)))
(defun vec3-print (v samples-per-pixel)
  (let ((scale (/ 1d0 samples-per-pixel)))
    (list (truncate (* 256d0 (clamp (sqrt (* scale (vec3-r v))) 0d0 0.999d0)))
          (truncate (* 256d0 (clamp (sqrt (* scale (vec3-g v))) 0d0 0.999d0)))
          (truncate (* 256d0 (clamp (sqrt (* scale (vec3-b v))) 0d0 0.999d0))))))

(defun color (r g b) (vec3 (/ r 255d0) (/ g 255d0) (/ b 255d0)))
(defparameter *colors*
  (vector (color 246 81 29) (color 251 131 15) (color 255 180 0) (color 44 84 139)
          (color 9 97 141) (color 0 165 207) (color 79 71 137) (color 95 88 148)))
(defun rand-color () (svref *colors* (random (length *colors*))))

(defstruct (ray (:constructor make-ray (origin direction))) origin direction)
(defun ray-at (r tt) (vec3-add (ray-origin r) (vec3-scale (ray-direction r) tt)))

(defstruct material scatter albedo (fuzz 0d0) (index-of-refraction 1d0))
(defstruct (sphere (:constructor make-sphere (center radius material)))
  center (radius 0d0 :type double-float) material)
(defstruct (hit-info (:constructor make-hit-info (point normal tt material front-face)))
  point normal tt material front-face)

(defun reflectance (cosine ref-idx)
  (let* ((r (/ (- 1d0 ref-idx) (+ 1d0 ref-idx)))
         (r2 (* r r)))
    (* (+ r2 (- 1d0 r2)) (expt (- 1d0 cosine) 5d0))))

(defun hit-sphere (s t-min t-max ray)
  (let* ((center (sphere-center s))
         (radius (sphere-radius s))
         (oc (vec3-sub (ray-origin ray) center))
         (a (vec3-length-squared (ray-direction ray)))
         (half-b (vec3-dot oc (ray-direction ray)))
         (c (- (vec3-length-squared oc) (* radius radius)))
         (discriminant (- (* half-b half-b) (* a c))))
    (when (< discriminant 0d0) (return-from hit-sphere nil))
    (let* ((sqrt-d (sqrt discriminant))
           (root (/ (- (- half-b) sqrt-d) a)))
      (when (or (< root t-min) (< t-max root))
        (setq root (/ (+ (- half-b) sqrt-d) a)))
      (when (or (< root t-min) (< t-max root)) (return-from hit-sphere nil))
      (let* ((point (ray-at ray root))
             (outward-normal (vec3-div (vec3-sub point center) radius))
             (front-face (< (vec3-dot (ray-direction ray) outward-normal) 0d0)))
        (make-hit-info point (if front-face outward-normal (vec3-neg outward-normal))
                       root (sphere-material s) front-face)))))

(defun hit-all (t-min t-max ray hittables)
  (let ((closest t-max) (hit nil))
    (dolist (s hittables hit)
      (let ((h (hit-sphere s t-min closest ray)))
        (when h (setq hit h closest (hit-info-tt h)))))))

;; Scatter functions return two values: scattered ray and attenuation.
(defun scatter-lambertian (ray hit)
  (declare (ignore ray))
  (let ((dir (vec3-add (hit-info-normal hit) (vec3-rand-unit-in-sphere))))
    (when (vec3-near-zero-p dir) (setq dir (hit-info-normal hit)))
    (values (make-ray (hit-info-point hit) dir)
            (material-albedo (hit-info-material hit)))))

(defun scatter-metal (ray hit)
  (let* ((m (hit-info-material hit))
         (reflected (vec3-reflect (vec3-normalize (ray-direction ray)) (hit-info-normal hit)))
         (scattered (make-ray (hit-info-point hit)
                              (vec3-add reflected (vec3-scale (vec3-rand-unit-in-sphere)
                                                              (material-fuzz m))))))
    (if (< 0d0 (vec3-dot (ray-direction scattered) (hit-info-normal hit)))
        (values scattered (material-albedo m))
        nil)))

(defun scatter-dielectric (ray hit)
  (let* ((ir (material-index-of-refraction (hit-info-material hit)))
         (ratio (if (hit-info-front-face hit) (/ 1d0 ir) ir))
         (unit-direction (vec3-normalize (ray-direction ray)))
         (normal (hit-info-normal hit))
         (cos-theta (min (vec3-dot (vec3-neg unit-direction) normal) 1d0))
         (sin-theta (sqrt (- 1d0 (* cos-theta cos-theta))))
         (direction (if (or (< 1d0 (* ratio sin-theta))
                            (< (rand) (reflectance cos-theta ratio)))
                        (vec3-reflect unit-direction normal)
                        (vec3-refract unit-direction normal ratio))))
    (values (make-ray (hit-info-point hit) direction) (v 1 1 1))))

(defun ray-cast (r bounces hittables)
  (if (< bounces 0)
      (v 0 0 0)
      (let ((hit (hit-all 0.001d0 99999999d0 r hittables)))
        (if hit
            (multiple-value-bind (scattered attenuation)
                (funcall (material-scatter (hit-info-material hit)) r hit)
              (if scattered
                  (vec3-mul (ray-cast scattered (1- bounces) hittables) attenuation)
                  (v 0 0 0)))
            (let ((tt (* 0.5d0 (+ (vec3-g (vec3-normalize (ray-direction r))) 1d0))))
              (vec3-add (vec3-scale (v 1 1 1) (- 1d0 tt))
                        (vec3-scale (color 246 81 29) tt)))))))

(defun rand-scene ()
  (let ((scene (list (make-sphere (v 0 -1000 0) 1000d0
                                  (make-material :albedo (color 79 71 137)
                                                 :scatter #'scatter-lambertian))
                     (make-sphere (v -4 1 0) 1d0
                                  (make-material :albedo (color 246 81 29)
                                                 :scatter #'scatter-lambertian))
                     (make-sphere (v 0 1 0) 1d0
                                  (make-material :index-of-refraction 1.5d0
                                                 :scatter #'scatter-dielectric))
                     (make-sphere (v 4 1 0) 1d0
                                  (make-material :albedo (color 0 165 207) :fuzz 0d0
                                                 :scatter #'scatter-metal)))))
    (dotimes (i 200)
      (let* ((x (- (mod i 21) 10))
             (z (- (/ i 21d0) 6))
             (choose-mat (rand))
             (center (v (+ x (* 0.9d0 (rand))) 0.2d0 (+ z (* 0.9d0 (rand))))))
        (when (< 0.9d0 (vec3-length (vec3-sub center (v 4 0.2d0 0))))
          (setq scene
                (append scene
                        (list (make-sphere
                               center 0.2d0
                               (cond ((< choose-mat 0.8d0)
                                      (make-material :albedo (rand-color)
                                                     :scatter #'scatter-lambertian))
                                     ((< choose-mat 0.95d0)
                                      (make-material :albedo (rand-color)
                                                     :fuzz (rand-real 0d0 0.5d0)
                                                     :scatter #'scatter-metal))
                                     (t (make-material :index-of-refraction 1.5d0
                                                       :scatter #'scatter-dielectric))))))))))
    scene))

(defun ray ()
  (let* ((aspect-ratio (/ 16d0 9d0))
         (image-width *w*)
         (image-height (truncate (/ image-width aspect-ratio)))
         (samples-per-pixel 2)
         (max-ray-bounces 10)
         (look-from (v 13 2 3))
         (look-at (v 0 0 0))
         (focus-distance 10d0)
         (camera-up (v 0 1 0))
         (theta (degrees->radians 20d0))
         (viewport-height (* 2 (tan (/ theta 2d0))))
         (viewport-width (* aspect-ratio viewport-height))
         (camera-w (vec3-normalize (vec3-sub look-from look-at)))
         (camera-u (vec3-normalize (vec3-cross camera-up camera-w)))
         (camera-v (vec3-cross camera-w camera-u))
         (origin look-from)
         (horizontal (vec3-scale camera-u (* viewport-width focus-distance)))
         (vertical (vec3-scale camera-v (* viewport-height focus-distance)))
         (lower-left-corner (vec3-sub (vec3-sub (vec3-sub origin (vec3-div horizontal 2d0))
                                                (vec3-div vertical 2d0))
                                      (vec3-scale camera-w focus-distance)))
         (hittables (rand-scene)))
    (do ((y (1- image-height) (1- y))) ((< y 0))
      (dotimes (x image-width)
        (let ((acc (v 0 0 0)))
          (dotimes (s samples-per-pixel)
            (let* ((u (/ (+ x (rand)) (- image-width 1)))
                   (vv (/ (+ y (rand)) (- image-height 1)))
                   (offset (v 0 0 0))
                   (r (make-ray (vec3-add origin offset)
                                (vec3-sub (vec3-add (vec3-add lower-left-corner
                                                              (vec3-scale horizontal u))
                                                    (vec3-scale vertical vv))
                                          (vec3-sub origin offset)))))
              (setq acc (vec3-add acc (ray-cast r max-ray-bounces hittables)))))
          (vec3-print acc samples-per-pixel))))))

(defun bench ()
  (dotimes (i 3) (ray))
  (dotimes (i 10) (time (ray))))
